# EditorConfig 配置
# 统一编辑器代码风格

# 根配置文件
root = true

# 所有文件
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2
max_line_length = 100

# Markdown 文件
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# JSON 文件
[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# 配置文件
[*.{config.js,config.ts}]
indent_style = tab

# Svelte 文件
[*.svelte]
indent_style = tab
indent_size = 2
